# Ouvre l'éditeur ($EDITOR, vim par défaut), puis sync auto si activée.
# Usage : open_editor [+LINE] FILE
open_editor() {
    local editor="${EDITOR:-vim}" extra=()
    # vim/nvim : charge les commandes carnet (liens, backlinks, images…)
    case "${editor%% *}" in
        vim|nvim|*/vim|*/nvim) extra=(-S "$CARNET_ROOT/share/vim/carnet.vim") ;;
    esac
    # $EDITOR peut contenir des options (ex: "code -w") : découpage voulu
    # shellcheck disable=SC2086
    $editor "${extra[@]}" "$@"
    [[ "$CARNET_AUTOSYNC" == "1" ]] && git_sync_background
    return 0
}

_mkdocs_running() {
    [[ -f "$MKDOCS_PID_FILE" ]] && kill -0 "$(cat "$MKDOCS_PID_FILE")" 2>/dev/null
}
