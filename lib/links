# Liens entre notes, backlinks, images collées.
# Appelé depuis vim via share/vim/carnet.vim (sous-commandes _link,
# _backlinks, _image) : la sortie standard est la seule donnée renvoyée.

_relpath() {
    # _relpath CIBLE DEPUIS_DOSSIER
    perl -MFile::Spec -e 'print File::Spec->abs2rel($ARGV[0], $ARGV[1])' "$1" "$2"
}

_note_title() {
    local t
    t=$(awk '/^# / { sub(/^# +/, ""); print; exit }' "$1" 2>/dev/null)
    [[ -n "$t" ]] && echo "$t" || basename "${1%.md}"
}

# Choisit une note et affiche un lien markdown relatif à FROM.
pick_link() {
    local from="$1" sel target rel
    sel=$(
        get_notes "$folder" | sort | fzf \
            --prompt=" link > " \
            --layout=reverse \
            --border=rounded \
            --preview="bat --style=numbers --color=always '$folder/{}.md' 2>/dev/null" \
            --preview-window=right:55%:wrap \
            --color="prompt:#83a598,pointer:#fabd2f"
    ) || return 0
    [[ -z "$sel" ]] && return 0

    target="$folder/$sel.md"
    rel=$(_relpath "$target" "$(dirname "$from")")
    [[ "$rel" == *" "* ]] && rel="<$rel>"
    printf '[%s](%s)' "$(_note_title "$target")" "$rel"
}

# Affiche "chemin_relatif:ligne:texte" pour chaque lien pointant vers TARGET.
_backlinks_of() {
    local target="$1"
    (
        cd "$folder"
        rg --line-number --no-heading --glob '!assets/**' '\]\(<?[^)]+\.md' . 2>/dev/null || true
    ) | T="$target" F="$folder" perl -MCwd=abs_path -MFile::Basename -ne '
        BEGIN { $t = abs_path($ENV{T}) }
        chomp;
        my ($f, $l, $txt) = split(/:/, $_, 3);
        $f =~ s{^\./}{};
        while ($txt =~ /\]\(<?([^)>#]+?\.md)/g) {
            (my $link = $1) =~ s/%20/ /g;
            my $p = abs_path(dirname("$ENV{F}/$f") . "/$link");
            if (defined $p && $p eq $t) { print "$f:$l:$txt\n"; last }
        }
    '
}

# Backlinks de TARGET dans fzf. --print : affiche "chemin_abs:ligne" (vim).
show_backlinks() {
    local target="$1" mode="${2:-}" list result file line
    list=$(_backlinks_of "$target")
    if [[ -z "$list" ]]; then
        echo "  no backlinks" >&2
        sleep 1
        return 0
    fi

    result=$(
        echo "$list" | fzf \
            --prompt="  backlinks > " \
            --layout=reverse \
            --border=rounded \
            --delimiter=":" \
            --preview='
                l={2}; start=$(( l > 5 ? l - 5 : 1 ))
                bat --style=numbers --color=always --highlight-line "$l" \
                    --line-range "${start}:$((l+30))" "'"$folder"'/{1}" 2>/dev/null
            ' \
            --preview-window=right:55%:wrap \
            --color="prompt:#83a598,pointer:#fabd2f"
    ) || return 0

    file=$(cut -d: -f1 <<< "$result")
    line=$(cut -d: -f2 <<< "$result")
    if [[ "$mode" == "--print" ]]; then
        printf '%s:%s' "$folder/$file" "$line"
    else
        open_editor "+${line}" "$folder/$file"
    fi
}

# Enregistre l'image du presse-papier dans assets/ à côté de la note
# et affiche le lien markdown (voir clipboard_png dans lib/platform).
paste_image() {
    local note="$1" dir name out
    dir="$(dirname "$note")/assets"
    name="$(basename "${note%.md}" | tr ' ' '-')-$(date +%Y%m%d-%H%M%S).png"
    out="$dir/$name"
    mkdir -p "$dir"

    clipboard_png "$out" || true

    if [[ ! -s "$out" ]]; then
        rm -f "$out"
        rmdir "$dir" 2>/dev/null || true
        echo "✗ no image in clipboard" >&2
        return 1
    fi
    printf '![](assets/%s)' "$name"
}
