search_notes() {
    local result file line

    result=$(
        cd "$folder"
        rg --line-number --color=always --smart-case "" . 2>/dev/null \
        | fzf \
            --ansi \
            --prompt="  search > " \
            --height=80% \
            --layout=reverse \
            --border=rounded \
            --color="prompt:#83a598,pointer:#fabd2f,hl:#fb4934" \
            --delimiter=":" \
            --nth="1,3.." \
            --bind="change:reload:rg --line-number --color=always --smart-case {q} $folder 2>/dev/null || true" \
            --preview='
                f={1}; l={2}
                f="${f#'"$folder"'/}"
                start=$(( l > 5 ? l - 5 : 1 ))
                bat --style=numbers,changes --color=always \
                    --highlight-line "$l" \
                    --line-range "${start}:$((l+30))" \
                    "'"$folder"'/$f" 2>/dev/null
            ' \
            --preview-window=right:60%:wrap
    ) || return 0

    file=$(echo "$result" | cut -d: -f1)
    line=$(echo "$result" | cut -d: -f2)

    # strip le prefix absolu si présent
    file="${file#$folder/}"

    [[ -n "$file" ]] && open_editor "+${line}" "$folder/$file"
}

search_tags() {
    local tag file all

    all=$(note_tags)
    if [[ -z "$all" ]]; then
        echo "  no tags found"
        sleep 1.2
        return
    fi

    tag=$(
        cut -f2 <<< "$all" \
        | sort | uniq -c | sort -rn \
        | awk '{ c = $1; $1 = ""; sub(/^ /, ""); printf "%s\t(%d)\n", $0, c }' \
        | fzf \
            --delimiter='\t' \
            --prompt="  tag > " \
            --height=40% \
            --layout=reverse \
            --border=rounded \
            --color="prompt:#83a598,pointer:#fabd2f" \
        | cut -f1
    ) || return 0

    [[ -z "$tag" ]] && return

    file=$(
        awk -F'\t' -v t="$tag" '$2 == t { print $1 }' <<< "$all" \
        | sort -u \
        | sed "s|^$folder/||;s|\\.md$||" \
        | fzf \
            --prompt="  #$tag > " \
            --height=60% \
            --layout=reverse \
            --border=rounded \
            --preview="bat --style=numbers --color=always '$folder/{}.md' 2>/dev/null" \
            --preview-window=right:55%:wrap
    ) || return 0

    [[ -n "$file" ]] && open_editor "$folder/${file}.md"
}

# Cases non cochées "- [ ]", format "chemin:ligne:texte".
# Échéance optionnelle "@AAAA-MM-JJ" : triées d'abord par date,
# marquées en retard / aujourd'hui ; les autres suivent.
# Les cases cochées pendant la session ($CARNET_TODO_SESSION) restent
# affichées avec "✓" pour pouvoir annuler.
_todo_list() {
    local today session="${CARNET_TODO_SESSION:-/dev/null}"
    today=$(date +%F)
    (
        cd "$folder"
        rg --line-number --no-heading --glob '!assets/**' \
            '^\s*- \[[ xX]\]\s+\S' . 2>/dev/null || true
    ) \
    | sed 's|^\./||' \
    | awk -v today="$today" -v session="$session" '
        BEGIN { while ((getline k < session) > 0) touched[k] = 1 }
        {
            split($0, p, ":"); key = p[1] ":" p[2]
            done = ($0 ~ /^[^:]*:[0-9]+:[ \t]*- \[[xX]\]/)
            if (done && !(key in touched)) next

            due = "9999-99-99"; tag = ""
            if (match($0, /@[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/))
                due = substr($0, RSTART + 1, 10)
            if (done)              tag = "  \033[32m✓ fait\033[0m"
            else if (due < today)  tag = "  \033[31m⚠ en retard\033[0m"
            else if (due == today) tag = "  \033[33m● aujourd'\''hui\033[0m"
            printf "%s\t%06d\t%s%s\n", due, NR, $0, tag
        }' \
    | sort -t$'\t' -k1,1 -k2,2n \
    | cut -f3-
}

# Coche / décoche la case de la ligne LINE de FILE (chemin relatif).
toggle_todo() {
    local file="$folder/$1" line="$2"
    [[ -f "$file" && "$line" =~ ^[0-9]+$ ]] || return 1
    L="$line" perl -pi -e '
        if ($. == $ENV{L}) { s/^(\s*- )\[ \]/$1\[x\]/ or s/^(\s*- )\[[xX]\]/$1\[ \]/ }
    ' "$file"
    [[ -n "${CARNET_TODO_SESSION:-}" ]] && echo "$1:$line" >> "$CARNET_TODO_SESSION"
    return 0
}

# Bascule chaque ligne "chemin:ligne:…" du fichier LIST (sélection fzf).
toggle_todos_from() {
    local f l _
    while IFS=: read -r f l _; do
        [[ -n "$f" ]] && toggle_todo "$f" "$l"
    done < "$1"
    [[ "$CARNET_AUTOSYNC" == "1" ]] && git_sync_background
    return 0
}

search_todos() {
    local me session result file line
    me=$(printf '%q' "$CARNET_BIN")
    session=$(mktemp)

    result=$(
        CARNET_TODO_SESSION="$session" _todo_list \
        | CARNET_TODO_SESSION="$session" fzf \
            --ansi \
            --multi \
            --prompt="  todo > " \
            --height=80% \
            --layout=reverse \
            --border=rounded \
            --color="prompt:#83a598,pointer:#fabd2f,hl:#fb4934" \
            --delimiter=":" \
            --header="↑↓ choisir  |  ctrl-x: cocher/décocher  |  tab: sélection multiple  |  enter: ouvrir
échéance : - [ ] truc @AAAA-MM-JJ" \
            --bind="ctrl-x:execute-silent($me _toggle_list {+f})+reload($me _todos)+clear-selection" \
            --preview='
                l={2}
                start=$(( l > 5 ? l - 5 : 1 ))
                bat --style=numbers --color=always \
                    --highlight-line "$l" --line-range "${start}:$((l+30))" \
                    "'"$folder"'/{1}" 2>/dev/null
            ' \
            --preview-window=right:55%:wrap
    ) || { rm -f "$session"; return 0; }
    rm -f "$session"

    result=$(head -1 <<< "$result")
    file=$(cut -d: -f1 <<< "$result")
    line=$(cut -d: -f2 <<< "$result")
    [[ -n "$file" ]] && open_editor "+${line}" "$folder/$file"
    return 0
}

search_by_date() {
    local file

    file=$(
        find "$folder" -type f -name "*.md" ! -path "*/assets/*" \
            -printf "%T@ %p\n" \
        | sort -nr \
        | cut -d' ' -f2- \
        | sed "s|^$folder/||;s|\.md$||" \
        | fzf \
            --prompt=" by date > " \
            --height=80% \
            --layout=reverse \
            --border=rounded \
            --color="prompt:#83a598,pointer:#fabd2f" \
            --preview="
                note=\"${folder}/{}.md\"
                if [[ -f \"\$note\" ]]; then
                    words=\$(wc -w < \"\$note\")
                    lines=\$(wc -l < \"\$note\")
                    modified=\$(perl -MPOSIX=strftime -e 'print strftime(\"%F %T\", localtime((stat \$ARGV[0])[9]))' \"\$note\")
                    echo \"─── \$words words  \$lines lines  modified: \$modified ───\"
                    echo \"\"
                    bat --style=numbers,changes --color=always \"\$note\"
                fi
            " \
            --preview-window=right:55%:wrap
    ) || return 0

    [[ -n "$file" ]] && open_editor "$folder/${file}.md"
}

search_by_size() {
    local file

    file=$(
        find "$folder" -type f -name "*.md" ! -path "*/assets/*" \
            -printf "%s %p\n" \
        | sort -nr \
        | cut -d' ' -f2- \
        | sed "s|^$folder/||;s|\.md$||" \
        | fzf \
            --prompt=" by size > " \
            --height=80% \
            --layout=reverse \
            --border=rounded \
            --color="prompt:#83a598,pointer:#fabd2f" \
            --preview="
                note=\"${folder}/{}.md\"
                if [[ -f \"\$note\" ]]; then
                    words=\$(wc -w < \"\$note\")
                    lines=\$(wc -l < \"\$note\")
                    size=\$(du -h \"\$note\" | cut -f1)
                    echo \"─── \$words words  \$lines lines  size: \$size ───\"
                    echo \"\"
                    bat --style=numbers,changes --color=always \"\$note\"
                fi
            " \
            --preview-window=right:55%:wrap
    ) || return 0

    [[ -n "$file" ]] && open_editor "$folder/${file}.md"
}
